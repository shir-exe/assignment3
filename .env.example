# Environment Configuration

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
MONGO_PORT=27017

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mongouser
MONGO_INITDB_ROOT_PASSWORD=mongopass
MONGO_URI=mongodb://mongouser:mongopass@mongo:27017/focusflow?authSource=admin
DATABASE_NAME=focusflow

# Security & JWT
JWT_SECRET_KEY=change_this_to_a_super_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client origin (for CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
